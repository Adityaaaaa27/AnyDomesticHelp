{
  "expo": {
    "name": "Any Domestic Help",
    "slug": "anydomestichelp",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./src/assets/logo.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anydomestichelp.app"
    },
    "android": {
      "package": "com.anydomestichelp.app",
      "versionCode": 7,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#0E6F5C"
      },
      "permissions": [
        "NOTIFICATIONS",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0E6F5C"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./src/assets/logo.png",
          "color": "#0E6F5C"
        }
      ],
      "expo-image"
    ],
    "extra": {
      "eas": {
        "projectId": "3d6bc07b-e261-41f5-9005-b8343875e8f7"
      }
    },
    "owner": "adityab27"
  }
}
